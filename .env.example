# Backend
NODE_ENV=development
PORT=3000

# Base de données
DB_HOST=db          # 'db' en docker-compose, 'localhost' en local sans Docker
DB_PORT=3306
DB_USER=dashboard_user
DB_PASSWORD=change_me
DB_NAME=dashboard_db
DB_ROOT_PASSWORD=change_me_root  # Requis par MariaDB dans docker-compose — non utilisé par le backend

# JWT
JWT_SECRET=minimum_32_characters_secret_change_me_in_production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30

# Compte administrateur
# Créé automatiquement au 1er démarrage sur une base vide — ignoré ensuite
# Email : adresse email valide utilisée comme identifiant de connexion
# Mot de passe : minimum 8 caractères
ADMIN_EMAIL=admin@example.com
ADMIN_INITIAL_PASSWORD=change_me_min_8_chars


# Tests E2E — débrider le throttle pour que les tests API (loginAdminApi) ne soient pas bloqués
THROTTLER_LIMIT=100

# Version de l'image Docker à déployer (tag GHCR)
# Utiliser 'latest' pour la dernière release, ou fixer une version (ex: 1.2.0) pour pincer
DASHBOARD_VERSION=latest
