# Backend
NODE_ENV=development
PORT=3000

# Base de données
DB_HOST=db          # 'db' en docker-compose, 'localhost' en local sans Docker
DB_PORT=3306
DB_USER=dashboard_user
DB_PASSWORD=change_me
DB_NAME=dashboard_db
DB_ROOT_PASSWORD=change_me_root  # Requis par MariaDB dans docker-compose — non utilisé par le backend

# JWT
JWT_SECRET=minimum_32_characters_secret_change_me_in_production
JWT_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=30

# Admin initial
ADMIN_USERNAME=admin
ADMIN_INITIAL_PASSWORD=change_me_now

# Rate limiting
THROTTLER_TTL=60000
THROTTLER_LIMIT=5

# CORS (dev uniquement)
# CORS_ORIGIN=http://localhost:4200
